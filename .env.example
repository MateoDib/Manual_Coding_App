# Configuration privée — modifiable avec Configurer.command.
# Valeurs entre guillemets doubles ; aucune commande shell n’est exécutée.

# Noms des codeurs, séparés par des virgules. Un changement de nom ne renomme pas les anciens codages.
HANDCODING_AUTHORS="AuthorX,AuthorY,AuthorZ"

# Codeur sélectionné par défaut ; doit appartenir à la liste ci-dessus.
HANDCODING_AUTHOR="AuthorX"

# 1 affiche l’assistance IA à la demande ; 0 la désactive. Aucun appel au démarrage.
HANDCODING_AI_ENABLED="0"

# Modèle utilisé pour les recommandations IA.
HANDCODING_AI_MODEL="gpt-6.1-sol"

# Port local du codage.
HANDCODING_CODING_PORT="8541"

# Port local de l’harmonisation ; différent de celui du codage.
HANDCODING_HARMONIZATION_PORT="8542"

# Clé privée facultative. Vide : utiliser celle de l’environnement du Mac. Ne jamais publier ce fichier.
OPENAI_API_KEY=""
